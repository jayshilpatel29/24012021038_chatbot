<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <!-- ========================= -->
    <!-- MAIN NEXUS CHAT SCREEN -->
    <!-- ========================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

        <!-- Menu Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/menuCard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#F7F7F7"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#DDDDDD"
            app:strokeWidth="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="☰"
                android:textColor="#222222"
                android:textSize="22sp" />

        </com.google.android.material.card.MaterialCardView>


        <!-- Nexus -->
        <TextView
            android:id="@+id/tvNexus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nexus"
            android:textColor="#F0444D"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/menuCard"
            app:layout_constraintBottom_toBottomOf="@id/menuCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- Settings -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settingsCard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            app:cardBackgroundColor="#F7F7F7"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#DDDDDD"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/menuCard">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#222222"
                android:textSize="20sp" />

        </com.google.android.material.card.MaterialCardView>


        <!-- Chat Messages -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerChat"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="10dp"
            app:layout_constraintTop_toBottomOf="@id/menuCard"
            app:layout_constraintBottom_toTopOf="@id/messageCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- Message Box -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/messageCard"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#F4F4F4"
            app:cardCornerRadius="15dp"
            app:cardElevation="0dp"
            app:strokeColor="#E2E2E2"
            app:strokeWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Type Message -->
                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="14dp"
                    android:background="@android:color/transparent"
                    android:gravity="top|start"
                    android:hint="How can I help you today?"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="3"
                    android:padding="0dp"
                    android:textColor="#222222"
                    android:textColorHint="#888888"
                    android:textSize="14sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Plus -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/addCard"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="#222222"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp" />

                </com.google.android.material.card.MaterialCardView>


                <!-- Model -->
                <TextView
                    android:id="@+id/tvModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Nexus"
                    android:textColor="#333333"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/addCard"
                    app:layout_constraintBottom_toBottomOf="@id/addCard" />

                <TextView
                    android:id="@+id/tvModelArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="⌄"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    app:layout_constraintStart_toEndOf="@id/tvModel"
                    app:layout_constraintBottom_toBottomOf="@id/tvModel" />


                <!-- Send -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/sendCard"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="#F0444D"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="↑"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ========================= -->
    <!-- HISTORY DRAWER -->
    <!-- ========================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/historyDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:elevation="16dp"
        android:padding="18dp"
        android:layout_gravity="start">

        <!-- Drawer Title -->
        <TextView
            android:id="@+id/tvDrawerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nexus"
            android:textColor="#F0444D"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


        <!-- New Chat -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewChat"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="25dp"
            android:text="+   New Chat"
            android:textAllCaps="false"
            android:textColor="#222222"
            android:textSize="14sp"
            android:gravity="start|center_vertical"
            android:backgroundTint="#F5F5F5"
            app:cornerRadius="12dp"
            app:strokeColor="#DDDDDD"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/tvDrawerTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- Recent -->
        <TextView
            android:id="@+id/tvRecent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Recent"
            android:textColor="#888888"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btnNewChat"
            app:layout_constraintStart_toStartOf="parent" />


        <!-- History List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHistory"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingBottom="20dp"
            app:layout_constraintTop_toBottomOf="@id/tvRecent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.drawerlayout.widget.DrawerLayout>